# Copy to .env and adjust. Never commit .env.
# If the password contains URL-special characters (@ : / %), percent-encode it in the URLs.

# --- PostgreSQL (used by the postgres container) ---
POSTGRES_USER=issue_sync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=issue_sync

# --- App (host-side values; docker-compose overrides hosts with service names) ---
DATABASE_URL=postgresql+asyncpg://issue_sync:change-me@localhost:5432/issue_sync
REDIS_URL=redis://localhost:6379/0
SLACK_CONFIG_PATH=config/slack.yaml
LOG_LEVEL=INFO

# --- Jira Cloud (API token: https://id.atlassian.com/manage-profile/security/api-tokens) ---
# The token's account is the system's service account; its accountId must equal
# service_account_id in config/jira.yaml. Verify with: uv run issue-sync jira-check
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=sync-bot@example.com
JIRA_API_TOKEN=change-me
JIRA_CONFIG_PATH=config/jira.yaml

# --- Host ports published by docker-compose (optional) ---
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# API_HOST_PORT=8000

# --- Integration tests only ---
# A server where the tests may CREATE and DROP throwaway databases.
# TEST_DATABASE_URL=postgresql+asyncpg://issue_sync:change-me@localhost:5432/postgres
