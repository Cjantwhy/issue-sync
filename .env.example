# Copy to .env and adjust. Never commit .env.
# If the password contains URL-special characters (@ : / %), percent-encode it in the URLs.

# --- PostgreSQL (used by the postgres container) ---
POSTGRES_USER=issue_sync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=issue_sync

# --- App (host-side values; docker-compose overrides hosts with service names) ---
DATABASE_URL=postgresql+asyncpg://issue_sync:change-me@localhost:5432/issue_sync
REDIS_URL=redis://localhost:6379/0
SLACK_CONFIG_PATH=config/slack.yaml
ASSIGNMENT_CONFIG_PATH=config/assignment.yaml
LOG_LEVEL=INFO

# --- Jira Cloud (API token: https://id.atlassian.com/manage-profile/security/api-tokens) ---
# The authenticated account is the system's service account; its accountId must equal
# service_account_id in config/jira.yaml. Verify with: uv run issue-sync jira-check
# Site URL: links in Slack and the sheet point here.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_CONFIG_PATH=config/jira.yaml
# Authentication, one of:
#  oauth - an Atlassian service account (Administration > Directory > Service accounts)
#          with an OAuth 2.0 credential (scopes read:jira-work, write:jira-work,
#          read:jira-user). Calls go through the api.atlassian.com gateway for the site's
#          cloud id (https://<site>/_edge/tenant_info shows it).
#  basic - a regular Atlassian account's email + API token.
JIRA_AUTH=oauth
JIRA_CLIENT_ID=change-me
JIRA_CLIENT_SECRET=change-me
JIRA_CLOUD_ID=change-me
# JIRA_EMAIL=sync-bot@example.com
# JIRA_API_TOKEN=change-me
# Secret of the Jira admin webhook (Settings > System > WebHooks); at least 16 chars.
JIRA_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Google Sheets ---
# JSON key of a service account with the Sheets API enabled. Share each spreadsheet with
# the account's client_email as an editor. Keep the key in secrets/ (git-ignored).
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# Shared secret sent by the Apps Script trigger (apps_script/Code.gs). At least 16 chars;
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHEETS_WEBHOOK_SECRET=change-me-to-a-long-random-string
# How often every worksheet is polled as a fallback. Must divide 60s or 60min.
SHEETS_POLL_INTERVAL_SECONDS=60

# --- Sync ---
# Public URL of this service; detail-page links written to the sheet start with it.
PUBLIC_BASE_URL=http://localhost:8000
# Attempts per ticket push before giving up (backoff 10s, 20s, 40s ... max 15 min).
PUSH_MAX_ATTEMPTS=8
# Reconciliation: how often (minutes, must divide 60), and when a push or notification
# counts as stuck (minutes).
RECONCILE_INTERVAL_MINUTES=15
RECONCILE_STALE_MINUTES=30

# --- LLM for AI triage (any OpenAI-compatible chat completions API) ---
# DeepSeek shown; for OpenAI use https://api.openai.com/v1 and e.g. gpt-4.1-mini.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=change-me
# json_object works everywhere; json_schema lets the API enforce the schema (OpenAI).
LLM_RESPONSE_FORMAT=json_object
# Provider-specific request fields as JSON. DeepSeek: disable thinking mode for triage.
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
LLM_TIMEOUT_SECONDS=60
# Classification attempts before the ticket is created without an AI judgement.
LLM_MAX_ATTEMPTS=3
CLASSIFIER_CONFIG_PATH=config/classifier.yaml

# --- Slack ---
# Bot token of a Slack app with the chat:write scope, installed in the workspace.
# Invite the bot to default_channel in config/slack.yaml.
SLACK_BOT_TOKEN=xoxb-change-me

# Serve /docs and /openapi.json (development only).
# ENABLE_API_DOCS=true

# --- Host ports published by docker-compose (optional) ---
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# API_HOST_PORT=8000

# --- Integration tests only ---
# A server where the tests may CREATE and DROP throwaway databases.
# TEST_DATABASE_URL=postgresql+asyncpg://issue_sync:change-me@localhost:5432/postgres
